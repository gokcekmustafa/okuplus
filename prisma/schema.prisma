// Oku+ — Nihai Prisma Schema (data model v1)
//
// NOTLAR:
// - Tüm PK'lar UUID v7'dir. `uuidv7()` fonksiyonu Postgres 18+ (built-in) veya
//   pg_uuidv7 extension'ı tarafından sağlanmalıdır (prisma/manual/001_uuidv7.sql).
// - Partial unique index'ler, RLS policy'leri ve trigger'lar Prisma'da ifade
//   edilemez; prisma/manual/*.sql içinde tutulur ve migration.sql'e gömülür.
// - RLS: uygulama her istekte `SET LOCAL app.tenant_id = '<uuid>'` ve
//   platform personeli için `SET LOCAL app.platform_role = '...'` ayarlar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

