# Oku+ — örnek ortam değişkenleri. Gerçek değerler asla repo'ya eklenmemelidir.
# Kopyalayın: cp .env.example .env
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>?schema=public"

# HTTP resource limits. Keep the body limit finite; increase only with a tested use case.
# BODY_LIMIT_BYTES="1000000"
# CONNECTION_TIMEOUT_MS="10000"
# REQUEST_TIMEOUT_MS="30000"
# KEEP_ALIVE_TIMEOUT_MS="5000"

# 8G-8 curriculum promotion: explicit target only; the script never falls back to DATABASE_URL.
# Use a verified non-test URL for STAGING/PRODUCTION, or oku_plus_test with the TEST-only approvals below.
CURRICULUM_PACK_DATABASE_URL="postgresql://<user>:<password>@<verified-host>:5432/<verified-db>?schema=public"
CURRICULUM_PACK_ENVIRONMENT="TEST"
CURRICULUM_PACK_LEVEL_CODE="<existing-level-code>"
CURRICULUM_PACK_SKILL_CODES="<skill-1>,<skill-2>,<skill-3>"
# Write confirmations are intentionally supplied per command and are not stored here.
# CURRICULUM_PACK_ALLOW_TEST_WRITE="I_HAVE_VERIFIED_8G8_TEST_TARGET"
# CURRICULUM_PACK_TEST_CANDIDATE_APPROVAL="I_HAVE_APPROVED_8G8_TEST_CANDIDATE"
# CURRICULUM_PACK_ALLOW_WRITE="I_HAVE_VERIFIED_8G8_TARGET"
# CURRICULUM_PACK_EDITORIAL_APPROVAL="I_HAVE_REVIEWED_8G8"

# RLS güvenlik testleri için ayrı uygulama rolü bağlantısı (rls-security.test.ts).
# postgres süper kullanıcısı RLS'i bypass eder; RLS doğrulaması bu rolle yapılır.
RLS_TEST_DATABASE_URL="postgresql://<oku_app>:<password>@<host>:5432/<db>?schema=public&connection_limit=1"

# JWT imzalama anahtarı (en az 32 karakter). Üretimde güçlü rastgele bir değer kullanın.
JWT_SECRET="change-me-please-32-chars-minimum-secret"
# Access token ömrü (saniye) — varsayılan 900 (15 dk)
# JWT_ACCESS_TTL_SECONDS="900"
# Refresh token ömrü (saniye) — varsayılan 604800 (7 gün)
# JWT_REFRESH_TTL_SECONDS="604800"

# Process-local abuse protection. Production should also enforce an edge/Redis
# limiter when running more than one application instance.
# RATE_LIMIT_WINDOW_SECONDS="60"
# RATE_LIMIT_MAX="120"
# RATE_LIMIT_AUTH_MAX="60"
# RATE_LIMIT_BILLING_MAX="60"
# RATE_LIMIT_WEBHOOK_MAX="120"
# RATE_LIMIT_PILOT_MAX="60"

# Social login OIDC audience/client ID listeleri (virgülle ayrılabilir).
# Client ID gizli değildir; provider secret/private key kesinlikle repository'ye konmaz.
GOOGLE_OIDC_CLIENT_IDS=""
APPLE_OIDC_CLIENT_IDS=""

# 8G-10 pilot readiness: local/TEST only; production pilot launch is not enabled by this flag.
# PILOT_MODE="off"
# PILOT_STUDENT_ACCESS="user-id-or-email,user-id-or-email"

# 8H-1 entitlement daily usage boundary; UTC is the explicit default until
# account timezone preferences are introduced. This is not a billing setting.
# ENTITLEMENT_TIMEZONE="UTC"

# 8H-5 iyzico: SANDBOX only. Keep empty until sandbox credentials, merchant ID,
# plan reference codes and a reachable HTTPS callback are verified.
# IYZICO_API_KEY=""
# IYZICO_SECRET_KEY=""
# IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# IYZICO_MERCHANT_ID=""
# IYZICO_SUBSCRIPTION_PLAN_MONTHLY=""
# IYZICO_SUBSCRIPTION_PLAN_YEARLY=""
# IYZICO_CHECKOUT_CALLBACK_URL="https://<verified-test-host>/billing/iyzico/checkout/callback"
# IYZICO_WEBHOOK_MAX_AGE_SECONDS="86400"
