{
  "name": "oku-plus",
  "version": "0.2.0",
  "private": true,
  "description": "Oku+ — EdTech SaaS platformu (backend)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:fingerprint": "tsx scripts/db-fingerprint.ts",
    "catalog:target-fingerprint": "tsx scripts/catalog-target-fingerprint.ts",
    "catalog:validate": "tsx scripts/bootstrap-canonical-catalog.ts --validate-only",
    "catalog:bootstrap:dry-run": "tsx scripts/bootstrap-canonical-catalog.ts --dry-run",
    "catalog:bootstrap": "tsx scripts/bootstrap-canonical-catalog.ts --apply",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolated-first-real-pack": "tsx scripts/test-isolated-first-real-pack.ts",
    "qa:curriculum-pack": "tsx scripts/qa-curriculum-pack.ts",
    "qa:curriculum-catalog": "tsx scripts/qa-curriculum-catalog.ts",
    "qa:curriculum-fixtures": "tsx scripts/qa-curriculum-fixtures.ts",
    "rebalance:curriculum-pack": "tsx scripts/rebalance-curriculum-pack.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.1",
    "jose": "^6.2.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
